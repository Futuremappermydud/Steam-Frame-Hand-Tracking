+//! Frame Hand Tracking pacing: is the hand detector due this frame? Asked only while not both hands are tracked. It runs
+//! on every frame shortly after a hand was lost and while its last run saw a hand that is not tracked yet (acquiring
+//! one takes a few runs: the detector reaches the start threshold only on some frames, so running it less often
+//! would only start the hand later); otherwise, when it sees nothing new, it is paced.
+static bool
+acquisition_due(const HandTracking *hgt)
+{
+	int every = 1;
+	if (hgt->frames_since_loss >= hgt->recent_loss_frames && !hgt->detector_saw_new_hand) {
+		const bool tracking = hgt->last_frame_hand_detected[0] || hgt->last_frame_hand_detected[1];
+		every = tracking ? hgt->acquire_every_n_frames : hgt->idle_acquire_every_n_frames;
+	}
+	return hgt->frames_since_detector + 1 >= every;
+}
+
+//! Frame Hand Tracking pacing: did this detector run see a hand that is not tracked yet? A detection for an untracked slot
+//! counts unless it is the tracked hand seen again (it overlaps that hand's region as a new detection may not).
+static bool
+sees_new_hand(const HandTracking *hgt, const hand_detection_run_info *infos, int num_views)
+{
+	for (int view_idx = 0; view_idx < num_views; view_idx++) {
+		for (int hand_idx = 0; hand_idx < 2; hand_idx++) {
+			const hand_region_of_interest &o = infos[view_idx].outputs[hand_idx];
+			if (!o.found || hgt->last_frame_hand_detected[hand_idx]) {
+				continue;
+			}
+			const hand_region_of_interest &other = hgt->views[view_idx].regions_of_interest_this_frame[!hand_idx];
+			if (hgt->last_frame_hand_detected[!hand_idx] && other.found &&
+			    hand_bounding_boxes_iou(o, other) > hgt->tuneable_values.mpiou_single_detection.val) {
+				continue;
+			}
+			return true;
+		}
+	}
+	return false;
+}
+
+//! Frame Hand Tracking false-positive memory: does a detection overlap a region where a just-detected hand was rejected?
+static bool
+in_rejected_region(const HandTracking *hgt, int view_idx, const hand_region_of_interest &roi)
+{
+	if (hgt->fp_suppress_ms <= 0 || !roi.found) {
+		return false;
+	}
+	const uint64_t now = hgt->current_frame_timestamp;
+	const uint64_t window = (uint64_t)(hgt->fp_suppress_ms * 1e6);
+	for (const HandTracking::rejected_region &r : hgt->rejected_regions[view_idx]) {
+		// Skip unused and expired regions, and any from a later time (the timestamps went backwards).
+		if (r.until_ns <= now || r.until_ns > now + window) {
+			continue;
+		}
+		box_iou::Box detection(roi.center_px, roi.size_px);
+		box_iou::Box rejected(r.center_px, r.size_px);
+		if (box_iou::boxIOU(detection, rejected) > 0.3f) {
+			return true;
+		}
+	}
+	return false;
+}
+
+//! Drops this frame's detections that fall in a rejected region (they neither start a hand nor count towards one).
+static void
+suppress_rejected_detections(HandTracking *hgt, hand_detection_run_info *infos, int num_views)
+{
+	for (int view_idx = 0; view_idx < num_views; view_idx++) {
+		for (int hand_idx = 0; hand_idx < 2; hand_idx++) {
+			hand_region_of_interest &o = infos[view_idx].outputs[hand_idx];
+			if (in_rejected_region(hgt, view_idx, o)) {
+				o.found = false;
+				o.hand_detection_confidence = 0;
+				hgt->fhl_detections_suppressed++;
+			}
+		}
+	}
+}
