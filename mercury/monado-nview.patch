+/*!
+ * The pose Mercury uses to move a point from a first camera's space into a second camera's space, from an OpenCV
+ * "second from first" rotation and translation. This is upstream getCalibration's arithmetic, unchanged, so every
+ * view of the N-view fork goes through the same conversion as upstream's right camera.
+ */
+static xrt_pose
+mercury_pose_from_cv(const double rotation[3][3], const double translation[3])
+{
+	xrt_vec3 trans = {
+	    (float)translation[0],
+	    (float)translation[1],
+	    (float)translation[2],
+	};
+
+	// Officially, I have no idea if this is row-major or col-major. Empirically it seems to work, and that
+	// is all I will say.
