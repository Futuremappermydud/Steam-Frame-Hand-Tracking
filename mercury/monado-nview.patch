+namespace xrt::tracking::hand::mercury {
+
+HandTracking *
+mercury_create_nview(int num_views,
+                     const struct t_camera_calibration *calibrations,
+                     const double (*view_from_ref_rotation)[9],
+                     const double (*view_from_ref_translation)[3],
+                     const struct t_camera_extra_info_one_view *extra_info,
+                     const char *models_folder)
+{
+	XRT_TRACE_MARKER();
+
+	if (num_views < 1 || num_views > kMaxViews || calibrations == NULL || models_folder == NULL) {
+		U_LOG_E("mercury_create_nview: invalid arguments (num_views %d)", num_views);
+		return NULL;
+	}
+
+	HandTracking *hgt = new HandTracking();
+	hgt->log_level = debug_get_log_option_mercury_log();
+	hgt->calib = NULL;
+	hgt->hand_masks_sink = NULL;
+	strncpy(hgt->models_folder, models_folder, ARRAY_SIZE(hgt->models_folder) - 1);
+
+	hgt->num_views = num_views;
+	// Upstream behaviour for two views; per-view acceptance, view selection and weights for more.
+	hgt->nview_policy = num_views > 2;
+
+	float max_fx = 0;
+	for (int view_idx = 0; view_idx < num_views; view_idx++) {
+		setup_view_calibration(hgt, view_idx, calibrations[view_idx]);
+		if (view_idx == 0) {
+			hgt->views[view_idx].view_from_ref = XRT_POSE_IDENTITY;
+		} else {
+			double rotation[3][3];
+			for (int i = 0; i < 9; i++) {
+				rotation[i / 3][i % 3] = view_from_ref_rotation[view_idx][i];
+			}
+			hgt->views[view_idx].view_from_ref = mercury_pose_from_cv(rotation, view_from_ref_translation[view_idx]);
+		}
+		if (extra_info != NULL) {
+			hgt->views[view_idx].camera_info = extra_info[view_idx];
+		}
+		max_fx = std::max(max_fx, (float)hgt->views[view_idx].hgdist_orig.fx);
+	}
+	// Optimizer weight: pixels per radian relative to the sharpest camera (Frame: SLAM 1.0, upper ~0.7).
+	for (int view_idx = 0; view_idx < num_views; view_idx++) {
+		hgt->views[view_idx].weight = max_fx > 0 ? (float)hgt->views[view_idx].hgdist_orig.fx / max_fx : 1.0f;
+	}
+	if (num_views >= 2) {
+		hgt->left_in_right = hgt->views[1].view_from_ref;
+		hgt->baseline = m_vec3_len(hgt->views[1].view_from_ref.position);
+	}
+	hgt->calibration_one_view_size_px = hgt->views[0].calib_size_px;
+	hgt->last_frame_one_view_size_px = hgt->views[0].frame_size_px;
+	hgt->multiply_px_coord_for_undistort = 1.0f;
+	hgt->hand_pose_camera_offset = XRT_POSE_IDENTITY;
+
+	return mercury_finish_create(hgt) ? hgt : NULL;
+}
