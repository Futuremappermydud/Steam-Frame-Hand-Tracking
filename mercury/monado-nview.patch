+//! Remembers where a hand was rejected in the frame it was detected (only its detector regions: a tracked hand that
+//! fails later says nothing about the place).
+static void
+remember_rejected_regions(HandTracking *hgt, int hand_idx)
+{
+	if (hgt->fp_suppress_ms <= 0) {
+		return;
+	}
+	const uint64_t now = hgt->current_frame_timestamp;
+	const uint64_t until = now + (uint64_t)(hgt->fp_suppress_ms * 1e6);
+	for (int view_idx = 0; view_idx < hgt->num_views; view_idx++) {
+		const hand_region_of_interest &roi = hgt->views[view_idx].regions_of_interest_this_frame[hand_idx];
+		if (!roi.found || roi.provenance != ROIProvenance::HAND_DETECTION) {
+			continue;
+		}
+		// An unused or expired slot, else the one that expires first.
+		HandTracking::rejected_region *slots = hgt->rejected_regions[view_idx];
+		int pick = 0;
+		for (int i = 0; i < HandTracking::kRejectedRegions; i++) {
+			if (slots[i].until_ns <= now) {
+				pick = i;
+				break;
+			}
+			if (slots[i].until_ns < slots[pick].until_ns) {
+				pick = i;
+			}
+		}
+		slots[pick] = {roi.center_px, roi.size_px, until};
+	}
+}
+
+//! N-view fork: a detection's centre as a ray in the reference (view 0) camera space (Mercury's flipped axes).
+static void
+detection_ray(HandTracking *hgt, int view_idx, const hand_region_of_interest &roi, Eigen::Vector3f &origin,
+              Eigen::Vector3f &direction)
+{
+	xrt_vec3 d = {};
+	t_camera_models_unproject_and_flip(&hgt->views[view_idx].hgdist, roi.center_px.x, roi.center_px.y, &d.x, &d.y,
+	                                   &d.z);
+	xrt_pose ref_from_view;
+	math_pose_invert(&hgt->views[view_idx].view_from_ref, &ref_from_view);
+	xrt_vec3 dir_ref;
+	math_quat_rotate_vec3(&ref_from_view.orientation, &d, &dir_ref);
+	origin = map_vec3(ref_from_view.position);
+	direction = map_vec3(dir_ref).normalized();
+}
+
+/*!
+ * N-view fork: do two detections of one hand slot agree in 3D? Their rays must pass within acquire_ray_gap_m of
+ * each other, at a point between acquire_min_depth_m and acquire_max_depth_m in front of both cameras.
+ */
+static bool
+detections_agree(HandTracking *hgt, int va, const hand_region_of_interest &a, int vb, const hand_region_of_interest &b)
+{
+	Eigen::Vector3f oa, da, ob, db;
+	detection_ray(hgt, va, a, oa, da);
+	detection_ray(hgt, vb, b, ob, db);
+	// Closest points of two lines.
+	const Eigen::Vector3f w = oa - ob;
+	const float A = da.dot(da), B = da.dot(db), Cc = db.dot(db), D = da.dot(w), E = db.dot(w);
+	const float den = A * Cc - B * B;
+	if (den < 1e-6f) {
+		return false; // parallel rays: no depth
+	}
+	const float s = (B * E - Cc * D) / den, t = (A * E - B * D) / den;
+	const Eigen::Vector3f pa = oa + s * da, pb = ob + t * db;
+	return s > hgt->acquire_min_depth_m && t > hgt->acquire_min_depth_m && s < hgt->acquire_max_depth_m &&
+	       t < hgt->acquire_max_depth_m && (pa - pb).norm() < hgt->acquire_ray_gap_m;
+}
+
+/*!
+ * N-view fork: hand detection over num_views cameras.
+ *
+ * The detector runs on detector_views_per_frame views per frame, rotating through all views (on every view while
+ * hand size is being refined or when forced). A new hand slot needs two detections that agree in 3D (see
+ * detections_agree), one of them at the stock 0.92 confidence: views point in different directions, so a hand is
+ * usually visible in only some of them and upstream's average over all views that ran would reject hands at the
+ * side, while one view alone too easily starts a hand on background. Overlap suppression is upstream's, per view.
+ * Views where the hand was not confirmed get no region; pose prediction fills them from the next frame.
+ */
+static void
+dispatch_and_process_hand_detections_nview(struct HandTracking *hgt)
+{
+	const int n = hgt->num_views;
+	if (hgt->tuneable_values.always_run_detection_model) {
+		for (int hand_idx = 0; hand_idx < 2; hand_idx++) {
+			hgt->this_frame_hand_detected[hand_idx] = false;
+			hgt->history_hands[hand_idx].clear();
+		}
+	}
+
+	hand_detection_run_info infos[kMaxViews] = {};
+	for (int view_idx = 0; view_idx < n; view_idx++) {
+		infos[view_idx].view = &hgt->views[view_idx];
+		for (int hand_idx = 0; hand_idx < 2; hand_idx++) {
+			infos[view_idx].outputs[hand_idx].found = false;
+			infos[view_idx].outputs[hand_idx].hand_detection_confidence = 0;
+			infos[view_idx].outputs[hand_idx].provenance = ROIProvenance::HAND_DETECTION;
+		}
+	}
+
+	bool no_hands_detected_last_frame = !(hgt->this_frame_hand_detected[0] || hgt->this_frame_hand_detected[1]);
+
+	const bool all = hgt->tuneable_values.always_run_detection_model || hgt->hand_size_refinement.isOptimizing() ||
+	                 hgt->tuneable_values.detection_model_in_both_views;
+	const int k = all ? n : std::clamp(hgt->detector_views_per_frame, 1, n);
+	bool run[kMaxViews] = {};
+	const int start = hgt->detection_counter % n;
+	hgt->detection_counter += k;
+	for (int i = 0; i < k; i++) {
+		run[(start + i) % n] = true;
+	}
+	for (int view_idx = 0; view_idx < n; view_idx++) {
+		if (run[view_idx]) {
+			u_worker_group_push(hgt->group, run_hand_detection, &infos[view_idx]);
+		}
+	}
+	u_worker_group_wait_all(hgt->group);
+	suppress_rejected_detections(hgt, infos, n);
+	hgt->detector_saw_new_hand = sees_new_hand(hgt, infos, n);
+
+	for (int hand_idx = 0; hand_idx < 2; hand_idx++) {
+		// The most confident pair of detections that agree in 3D, one of them at 0.92.
+		float best = 0;
+		bool confirmed[kMaxViews] = {};
+		for (int va = 0; va < n; va++) {
+			const hand_region_of_interest &a = infos[va].outputs[hand_idx];
+			if (!run[va] || !a.found) {
+				continue;
+			}
+			for (int vb = va + 1; vb < n; vb++) {
+				const hand_region_of_interest &b = infos[vb].outputs[hand_idx];
+				if (!run[vb] || !b.found) {
+					continue;
+				}
+				const float hi = std::max(a.hand_detection_confidence, b.hand_detection_confidence);
+				const float sum = a.hand_detection_confidence + b.hand_detection_confidence;
+				if (hi < 0.92 || sum <= best || !detections_agree(hgt, va, a, vb, b)) {
+					continue;
+				}
+				best = sum;
+				std::fill(std::begin(confirmed), std::end(confirmed), false);
+				confirmed[va] = confirmed[vb] = true;
+			}
+		}
+		hgt->fhl_acquisition_confidence[hand_idx] = best / 2;
+		if (best == 0 && !hgt->acquire_require_pair) {
+			// Upstream-like: the most confident single view at 0.92 starts the hand.
+			int single = -1;
+			for (int view_idx = 0; view_idx < n; view_idx++) {
+				const hand_region_of_interest &o = infos[view_idx].outputs[hand_idx];
+				if (run[view_idx] && o.found && o.hand_detection_confidence >= 0.92 &&
+				    (single < 0 || o.hand_detection_confidence >
+				                       infos[single].outputs[hand_idx].hand_detection_confidence)) {
+					single = view_idx;
+				}
+			}
+			if (single >= 0) {
+				confirmed[single] = true;
+				best = infos[single].outputs[hand_idx].hand_detection_confidence;
+				hgt->fhl_acquisition_confidence[hand_idx] = best;
+			}
+		}
+		if (best == 0) {
+			continue;
+		}
+		// Other views that also saw it, in agreement with the pair.
+		int anchor = 0;
+		while (!confirmed[anchor]) {
+			anchor++;
+		}
+		for (int view_idx = 0; view_idx < n; view_idx++) {
+			const hand_region_of_interest &o = infos[view_idx].outputs[hand_idx];
+			if (!confirmed[view_idx] && run[view_idx] && o.found &&
+			    detections_agree(hgt, anchor, infos[anchor].outputs[hand_idx], view_idx, o)) {
+				confirmed[view_idx] = true;
+			}
+		}
+
+		if (hgt->tuneable_values.always_run_detection_model || !hgt->last_frame_hand_detected[hand_idx]) {
+			bool good_to_go = true;
+			for (int view_idx = 0; view_idx < n && good_to_go; view_idx++) {
+				if (!confirmed[view_idx]) {
+					continue;
+				}
+				if (no_hands_detected_last_frame) {
+					// Both hands detected in the same place (hands together): reject.
+					float iou = hand_bounding_boxes_iou(infos[view_idx].outputs[hand_idx],
+					                                    infos[view_idx].outputs[!hand_idx]);
+					good_to_go = !(iou > hgt->tuneable_values.mpiou_double_detection.val);
+				} else {
+					// A new hand where the other hand is already tracked: reject.
+					float iou = hand_bounding_boxes_iou(
+					    infos[view_idx].outputs[hand_idx],
+					    hgt->views[view_idx].regions_of_interest_this_frame[!hand_idx]);
+					good_to_go = !(iou > hgt->tuneable_values.mpiou_single_detection.val);
+				}
+			}
+
+			if (good_to_go) {
+				for (int view_idx = 0; view_idx < n; view_idx++) {
+					hand_region_of_interest &roi = hgt->views[view_idx].regions_of_interest_this_frame[hand_idx];
+					if (confirmed[view_idx]) {
+						roi = infos[view_idx].outputs[hand_idx];
+					} else {
+						roi.found = false;
+					}
+				}
+			}
+		}
+
+		hgt->this_frame_hand_detected[hand_idx] = true;
+	}
+}
