+// V9 research: detector input as one rotate+crop+scale warp. Returns detector->image like blackbar().
+static cv::Matx23f
+fhl_rotated_crop(const cv::Mat &in, float angle_deg, float crop, cv::Mat &out, xrt_size out_size)
+{
+	const double w = in.cols, h = in.rows, side = crop * std::min(w, h), s = out_size.w / side;
+	cv::Mat R = cv::getRotationMatrix2D(cv::Point2f(w / 2, h / 2), angle_deg, 1.0);
+	cv::Matx33d A(R.at<double>(0, 0), R.at<double>(0, 1), R.at<double>(0, 2),
+	              R.at<double>(1, 0), R.at<double>(1, 1), R.at<double>(1, 2), 0, 0, 1);
+	cv::Matx33d T(s, 0, -(w / 2 - side / 2) * s, 0, s, -(h / 2 - side / 2) * s, 0, 0, 1);
+	cv::Matx33d go = T * A;
+	cv::Matx23f go23(go(0, 0), go(0, 1), go(0, 2), go(1, 0), go(1, 1), go(1, 2));
+	cv::warpAffine(in, out, go23, cv::Size(out_size.w, out_size.h));
+	cv::Matx33d back = go.inv();
+	return cv::Matx23f(back(0, 0), back(0, 1), back(0, 2), back(1, 0), back(1, 1), back(1, 2));
+}
